; William: Ecos do Último Trem — Godot 4.6
config_version=5

[application]
config/name="William — Limiar de Aurora"
run/main_scene="res://intro/intro.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Uma introdução de fantasia procedural: exploração, criaturas e poderes elementais."
config/version="0.2.0"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.022,0.043,0.065,1)

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_mouse_from_touch=false
